# Names/defaults canonical in docs/00-master.md §8. Copy to .env and fill in.

# --- chatbot (Kapso / WhatsApp / AI) ---
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp/v24.0
KAPSO_DELIVERY_FLOW_ID=            # WhatsApp Flow for the delivery-data form (published in Kapso)
WHATSAPP_NUMBER_SALES=             # Kapso phone_number_id of the sales line
WHATSAPP_NUMBER_SUPPORT=           # Kapso phone_number_id of the support line
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-sonnet-5
MODEL_ESCALATION=claude-sonnet-5
SUPPORT_NUMBER=                    # REQUIRED-BUT-UNKNOWN: client (Lisandro) provides later

# --- Meta leadgen webhook (Flow D) ---
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
IG_GREETING_TEMPLATE=ig_lead_greeting

# --- WaterService ---
WATERSERVICE_BASE_URL=
WATERSERVICE_USER=
WATERSERVICE_PASSWORD=
WS_INCIDENT_TYPE_ID=1              # per-env; client confirms with vendor
WS_INCIDENT_SUBTYPE_ID=28          # per-env; client confirms with vendor
WS_SEVERITY_ID=2
WS_TIPO_LISTA_ID=2                 # per-env; #10 matrix list type
WS_CENTRO_DISTRIBUCION_MAP={"mercedes":"1","luján":"1","san andrés de giles":"1","san antonio de areco":"1","chivilcoy":"1","campana":"1","zárate":"1"}

# --- Sheets / geocoding / coverage ---
GOOGLE_SERVICE_ACCOUNT_JSON=
ORDERS_SHEET_ID=
GOOGLE_MAPS_API_KEY=
GEOCODING_PROVIDER=waterservice    # waterservice | googlemaps
COVERAGE_RADIUS_M=1000

# --- follow-ups / debt ---
BUSINESS_HOURS=09-21
FOLLOWUP_SCHEDULE=1h,8h,23h
MAX_FOLLOWUP_CYCLES=2
WEB_CONFIRMATION_TEMPLATE=false
DEBT_THRESHOLD=0
DEBT_REMINDER_COOLDOWN_DAYS=14
DEBT_REMINDER_SEND_HOUR=09

# --- prices (open item 00-master §10a — client confirms source) ---
# Price list is deterministic by city: PRICE_LIST_DEFAULT_ID (LISTA PRECIOS
# GENERAL) applies to everyone; CITY_PRICE_LIST_MAP holds per-city exceptions
# (e.g. Lobos → PRECIO LOBOS). The neighbor-derived list is NOT used for pricing.
PRICE_LIST_DEFAULT_ID=             # id of "LISTA PRECIOS GENERAL" in the WS matrix
CITY_PRICE_LIST_MAP={"lobos":""}   # per-city overrides, e.g. lobos → "PRECIO LOBOS" id
PRICES_SOURCE=                     # waterservice | sheet (NO default — must be set)
PRICES_SHEET_ID=

OPERATOR_PHONE=

# --- CRM (Chatwoot mirror) ---
CHATWOOT_BASE_URL=
CHATWOOT_API_ACCESS_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_WEBHOOK_SECRET=

# --- service ---
PORT=3000
DB_PATH=./cimes.db
AI_MAX_TOKENS=1024
AI_MAX_UNPRODUCTIVE_TURNS=6
