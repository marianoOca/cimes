# Chatwoot env (copy to .env). Full reference: https://www.chatwoot.com/docs/self-hosted
SECRET_KEY_BASE=replace-with-64-random-hex-chars
FRONTEND_URL=https://crm.example.com
DEFAULT_LOCALE=es
TZ=America/Argentina/Buenos_Aires

POSTGRES_HOST=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=replace-me
REDIS_URL=redis://redis:6379

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
ACTIVE_STORAGE_SERVICE=local

# Mailer (operator invites / password resets) — fill with the client's SMTP.
MAILER_SENDER_EMAIL=CIMES CRM <crm@example.com>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
