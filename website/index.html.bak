<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>CIMES — Agua y soda a domicilio en Mercedes, Luján, Chivilcoy, Campana y Zárate</title>
  <meta name="description" content="Bidones de agua, soda a domicilio y dispensers con reparto semanal en Mercedes, Luján, San Andrés de Giles, San Antonio de Areco, Chivilcoy, Campana y Zárate. Alta automática en 2 minutos." />
  <meta property="og:title" content="CIMES — Agua y soda a domicilio" />
  <meta property="og:description" content="Bidones, soda en sifón y dispensers de agua con reparto semanal. Alta automática online o por WhatsApp." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="assets/logo-cimes.png" />
  <link rel="icon" href="assets/logo-cimes.png" />
  <link rel="stylesheet" href="styles.css" />
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "CIMES",
    "description": "Agua y soda a domicilio con reparto semanal: bidones retornables, soda en sifón, saborizadas y dispensers.",
    "areaServed": ["Mercedes", "Luján", "San Andrés de Giles", "San Antonio de Areco", "Chivilcoy", "Campana", "Zárate"],
    "email": "contacto@cimes.com.ar",
    "sameAs": ["https://www.instagram.com/cimes.silva"]
  }
  </script>
  <!-- GTM: the client's existing Google Tag Manager container goes here (04 §8).
       Paste the GTM snippet (head part) on deploy — container id from the client. -->
</head>
<body>
  <!-- GTM (noscript body part) goes here on deploy. -->

  <header class="site-header">
    <a class="brand" href="#">CIMES</a>
    <nav>
      <a href="#alta" data-copy="nav.signup"></a>
      <a id="nav-wa" href="#" target="_blank" rel="noopener" data-copy="nav.whatsapp"></a>
    </nav>
  </header>

  <!-- 1. Hero -->
  <section class="hero">
    <h1 data-copy="hero.title"></h1>
    <p data-copy="hero.subtitle"></p>
    <a class="btn btn-primary" href="#alta" data-copy="hero.cta"></a>
  </section>

  <!-- 2. Dual CTA block -->
  <section class="dual-cta" id="sumate">
    <h2 data-copy="dualCta.title"></h2>
    <div class="cards">
      <div class="card">
        <h3 data-copy="dualCta.auto.title"></h3>
        <p data-copy="dualCta.auto.description"></p>
        <a class="btn btn-primary" href="#alta" data-copy="dualCta.auto.button"></a>
      </div>
      <div class="card">
        <h3 data-copy="dualCta.whatsapp.title"></h3>
        <p data-copy="dualCta.whatsapp.description"></p>
        <a class="btn btn-whatsapp wa-link" href="#" target="_blank" rel="noopener" data-copy="dualCta.whatsapp.button"></a>
      </div>
    </div>
  </section>

  <!-- 3. Self-service signup wizard (Flow B) -->
  <section class="wizard" id="alta">
    <h2 data-copy="wizard.title"></h2>
    <p class="wizard-subtitle" data-copy="wizard.subtitle"></p>
    <div id="wizard-root" class="card wizard-card" aria-live="polite"></div>
  </section>

  <!-- 4. ¿Cómo funciona? -->
  <section class="how">
    <h2 data-copy="how.title"></h2>
    <div class="cards" id="how-steps"></div>
  </section>

  <!-- 5. Product catalog grid (marketing — prices omitted by design, 04 §2.5) -->
  <section class="products">
    <h2 data-copy="products.title"></h2>
    <p class="note" data-copy="products.note"></p>
    <div class="grid" id="product-grid"></div>
  </section>

  <!-- 6. Trust -->
  <section class="trust">
    <h2 data-copy="trust.title"></h2>
    <div class="cards" id="trust-items"></div>
  </section>

  <!-- 7. Coverage -->
  <section class="coverage">
    <h2 data-copy="coverage.title"></h2>
    <p data-copy="coverage.text"></p>
    <ul id="coverage-cities"></ul>
  </section>

  <!-- 8. Testimonials (client provides the 3 real ones — placeholder slots) -->
  <section class="testimonials">
    <h2 data-copy="testimonials.title"></h2>
    <div class="cards" id="testimonial-items"></div>
  </section>

  <!-- 9. Footer -->
  <footer class="site-footer">
    <p><a id="footer-email" href="#"></a></p>
    <p class="social">
      <a id="footer-ig" href="#" target="_blank" rel="noopener">Instagram</a>
      <a id="footer-fb" href="#" target="_blank" rel="noopener">Facebook</a>
      <a id="footer-tt" href="#" target="_blank" rel="noopener">TikTok</a>
    </p>
    <p><a href="privacy.html" data-copy="footer.privacy"></a></p>
    <p data-copy="footer.rights"></p>
  </footer>

  <!-- Floating WhatsApp widget -->
  <a class="wa-float wa-link" href="#" target="_blank" rel="noopener" aria-label="WhatsApp">💬</a>

  <script src="config.js"></script>
  <script src="copy.es-AR.js"></script>
  <script src="app.js"></script>
</body>
</html>
